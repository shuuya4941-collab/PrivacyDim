<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Privacy Dim"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnOverlayPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1) منح صلاحية العرض فوق التطبيقات" />

        <Button
            android:id="@+id/btnAccessibilitySettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="2) تفعيل خدمة إمكانية الوصول" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="اسم حزمة التطبيق المستهدف (مثال: com.whatsapp)" />

        <EditText
            android:id="@+id/editTargetPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="com.example.app" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAppDim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="تعتيم عند فتح التطبيق المحدد" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchFaceDim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="تعتيم عند عدم اكتشاف وجه ينظر للهاتف" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="حفظ الإعدادات" />

        <Button
            android:id="@+id/btnToggleMaster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="تفعيل / إيقاف الآن" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>
